  "caps": [
   {
    "t0": 0,
    "t1": 1.72,
    "text": "'개인정보 유출,\n보상해 드릴게요.'"
   },
   {
    "t0": 1.87,
    "t1": 4.04,
    "text": "이런 연락 오면\n바로 끊으셔야 합니다."
   },
   {
    "t0": 4.39,
    "t1": 7.13,
    "text": "은행에 이어\n이번엔 보험사까지 뚫렸거든요."
   },
   {
    "t0": 7.28,
    "t1": 10.96,
    "text": "국민은행은 피해자가\n처음 발표보다 18배로 늘었고요."
   },
   {
    "t0": 11.26,
    "t1": 13.7,
    "text": "그런데 진짜 위험은\n지금부터인데요."
   },
   {
    "t0": 13.85,
    "t1": 16.02,
    "text": "이 소식을 미끼로 한\n사칭 연락이요."
   },
   {
    "t0": 16.17,
    "t1": 19.53,
    "text": "경찰도 4,800만 명에게\n경고 문자를 보내기로 했죠."
   },
   {
    "t0": 19.83,
    "t1": 21.29,
    "text": "기억할 건 딱 세 가지예요."
   },
   {
    "t0": 21.44,
    "t1": 25.0,
    "text": "보상·계좌 보호 연락은 끊고\n대표번호로 직접 확인하기."
   },
   {
    "t0": 25.2,
    "t1": 27.67,
    "text": "문자 속 링크나 앱 설치는\n절대 금지."
   },
   {
    "t0": 27.87,
    "t1": 29.96,
    "text": "의심되면 1394로\n신고하세요."
   },
   {
    "t0": 30.26,
    "t1": 32.42,
    "text": "이 영상,\n부모님께 꼭 보내 드리세요."
   }
  ],
