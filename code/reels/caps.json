[
{
"t0": 0.0,
"t1": 2.16,
"text": "금융사 열여섯 곳이\n뚫렸습니다."
},
{
"t0": 2.54,
"t1": 5.26,
"text": "정부가 이번에 처음으로\n공식 집계를 냈는데요."
},
{
"t0": 5.5,
"t1": 6.88,
"text": "은행부터 저축은행,"
},
{
"t0": 6.88,
"t1": 7.43,
"text": "캐피탈,"
},
{
"t0": 7.43,
"t1": 8.94,
"text": "가상자산 거래소까지,"
},
{
"t0": 8.94,
"t1": 12.23,
"text": "새어 나간 개인정보가\n10만 건에 달합니다."
},
{
"t0": 12.62,
"t1": 14.43,
"text": "이름이랑 연락처는\n물론이고,"
},
{
"t0": 14.43,
"t1": 16.6,
"text": "주민등록번호까지 들어\n있었습니다."
},
{
"t0": 17.14,
"t1": 19.78,
"text": "그나마 비밀번호랑\n카드번호는 안전하다고"
},
{
"t0": 19.78,
"t1": 20.29,
"text": "하네요."
},
{
"t0": 20.3,
"t1": 20.88,
"text": "그런데요,"
},
{
"t0": 20.88,
"t1": 23.07,
"text": "정작 더 놀라운 건 따로\n있습니다."
},
{
"t0": 23.3,
"t1": 27.17,
"text": "금융당국이 금융사\n555곳을 들여다봤더니,"
},
{
"t0": 27.37,
"t1": 30.16,
"text": "130곳이 기본조차 안\n지키고 있었던 거죠."
},
{
"t0": 30.47,
"t1": 32.41,
"text": "보안 업데이트는 미뤄\n두고,"
},
{
"t0": 32.41,
"t1": 34.48,
"text": "오래된 시스템은 그대로\n쓰고,"
},
{
"t0": 34.69,
"t1": 37.08,
"text": "24시간 지켜보는 사람도\n없었습니다."
},
{
"t0": 37.82,
"t1": 40.42,
"text": "심지어 2단계 인증조차\n없는 곳도 있었고요."
},
{
"t0": 40.63,
"t1": 42.23,
"text": "그럼 우리는 뭘 해야\n할까요?"
},
{
"t0": 42.73,
"t1": 44.19,
"text": "딱 세 가지만 기억하세요."
},
{
"t0": 44.76,
"t1": 47.74,
"text": "금융사라며 걸려 온 전화나\n문자는 일단 끊고,"
},
{
"t0": 47.74,
"t1": 50.0,
"text": "대표번호로 직접 다시 거는\n겁니다."
},
{
"t0": 50.51,
"t1": 52.7,
"text": "명의도용 안심차단도 켜\n두시고요."
},
{
"t0": 53.11,
"t1": 53.76,
"text": "마지막으로,"
},
{
"t0": 53.76,
"t1": 56.59,
"text": "지금 쓰는 금융 앱에\n2단계 인증이 켜져 있는지"
},
{
"t0": 56.59,
"t1": 57.67,
"text": "꼭 확인해 보세요."
},
{
"t0": 57.77,
"t1": 61.01,
"text": "이 영상은 부모님께도 한번\n보내 드리세요."
}
]